# Lovable Cloud DB uses Supabase under the hood.
# Keep these in local .env (and Lovable's environment file settings), not Lovable Secrets.
VITE_PUBLIC_URL=https://mobiwaveai.co.ke
VITE_AUTH_REDIRECT_URL=https://mobiwaveai.co.ke

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

APP_SITE_URL=https://mobiwaveai.co.ke
PAYSTACK_SECRET_KEY=sk_live_or_test_key
VITE_CLOUDFLARE_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
