# Lovable Cloud DB uses Supabase under the hood.
# Keep these in local .env (and Lovable's environment file settings), not Lovable Secrets.
VITE_PUBLIC_URL=https://ai.mobiwave.co.ke
VITE_AUTH_REDIRECT_URL=https://ai.mobiwave.co.ke

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
